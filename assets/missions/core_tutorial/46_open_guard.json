    "pages": [
      {
        "id": "p0",
        "title": "No Guard Is Complete",
        "text": "EFZ has no absolute guard. A STANDING guard loses to lows. A CROUCHING guard loses to overheads. And NO guard stops a throw. Every defensive stance leaves one door open - your job is to find which."
      },
      {
        "id": "p1",
        "title": "The Drill",
        "text": "The dummy will hold one fixed guard at a time. Open the standing guard with your low, strike the crouching guard high, and when it just blocks everything - walk up and THROW. Watch which of your options each stance is helpless against."
      }
    ],
