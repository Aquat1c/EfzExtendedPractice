    "pages": [
      {
        "id": "p0",
        "title": "Defense Is Not Passive",
        "text": "While you block and Recoil Guard, your RF Gauge builds at DOUBLE speed - good defense literally pays you. But there is no absolute guard: letting go of block at the wrong moment gets you hit even inside a blockstring."
      },
      {
        "id": "p1",
        "title": "Find the Real Gap",
        "text": "Pressure strings are not seamless - most have a gap where the attacker's turn briefly ends. THAT is where you escape or challenge. Mashing anywhere else is exactly what the attacker is fishing for."
      },
      {
        "id": "p2",
        "title": "The Drill",
        "text": "Misaki loops a fixed string with one real gap in the middle and a heavy ender. First just survive it. Then jump out through the gap. Then Recoil Guard the ender. Three answers to the same string - learn all three."
      }
    ],
    "tasks": [
      {
        "id": "block_all",
        "kind": "combat",
        "label": "Survive the whole string - just block",
        "prompt": "Misaki runs a fixed pressure string: {input:5A} > {input:5B} > {input:5C}. Hold {dir:4} and BLOCK it all - do not press anything.",
        "script": "ep_pressure_a",
        "absence": {
