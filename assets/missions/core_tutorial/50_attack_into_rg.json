    "pages": [
      {
        "id": "p0",
        "title": "When YOUR Attack Gets RG'd",
        "text": "An RG against you is not the end of your turn - it is the start of an RG battle. As long as you are still inside the move that got Recoil Guarded, you can Recoil Counter their punish right back - no matter how deep into the move you are."
      },
      {
        "id": "p1",
        "title": "Your Three Outs",
        "text": "One: cancel into a fast follow-up that reaches them before their answer. Two: stay in the move and Recoil Counter their answer - the tug of war. Three: if your pressure was blocked and you have no safe continuation, accept it - guard and give the turn back."
      },
      {
        "id": "p2",
        "title": "The Drill",
        "text": "Practice three related decisions: beat an RG answer with a fast normal cancel, stay in the original move and Recoil Counter, then recognize an ordinary block and safely end your turn."
      }
    ],
    "tasks": [
      {
        "id": "safe_cancel",
        "kind": "combat",
        "label": "Beat the RG answer: {input:c.5B} > {input:f.5B}",
